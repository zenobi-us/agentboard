,[\"/cli/workspaces-21\",{\"id\":\"/cli/workspaces-21\",\"page_id\":\"/cli/workspaces\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/workspaces#where-specific-config-lives\",\"content\":\"`agentboard/worktree`\"}],[\"/cli/workspaces-22\",{\"id\":\"/cli/workspaces-22\",\"page_id\":\"/cli/workspaces\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/workspaces#where-specific-config-lives\",\"content\":\"`agentboard/run-cmd`\"}],[\"/cli/workspaces-23\",{\"id\":\"/cli/workspaces-23\",\"page_id\":\"/cli/workspaces\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/workspaces#cli-validation-rules\",\"content\":\"Source ids must be non-empty and unique.\"}],[\"/cli/workspaces-24\",{\"id\":\"/cli/workspaces-24\",\"page_id\":\"/cli/workspaces\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/workspaces#cli-validation-rules\",\"content\":\"Action ids are optional, unique within one Source, and match `[A-Za-z_][A-Za-z0-9_]*`.\"}],[\"/cli/workspaces-25\",{\"id\":\"/cli/workspaces-25\",\"page_id\":\"/cli/workspaces\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/workspaces#cli-validation-rules\",\"content\":\"Unknown Actions fail validation.\"}],[\"/cli/workspaces-26\",{\"id\":\"/cli/workspaces-26\",\"page_id\":\"/cli/workspaces\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/workspaces#cli-validation-rules\",\"content\":\"Unknown Workspace, Source, and typed Action input fields fail validation.\"}],[\"/cli/workspaces-27\",{\"id\":\"/cli/workspaces-27\",\"page_id\":\"/cli/workspaces\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/workspaces#cli-validation-rules\",\"content\":\"Generate the JSON Schema from the same registered Source and Action schemas used by loading:\"}],[\"/sources/github\",{\"id\":\"/sources/github\",\"page_id\":\"/sources/github\",\"type\":\"page\",\"content\":\"GitHub source\",\"breadcrumbs\":[\"AgentBoard\",\"Sources\"],\"tags\":[],\"url\":\"/sources/github\"}],[\"/sources/github-0\",{\"id\":\"/sources/github-0\",\"page_id\":\"/sources/github\",\"type\":\"heading\",\"tags\":[],\"url\":\"/sources/github#github-source\",\"content\":\"GitHub source\"}],[\"/sources/github-1\",{\"id\":\"/sources/github-1\",\"page_id\":\"/sources/github\",\"type\":\"heading\",\"tags\":[],\"url\":\"/sources/github#identity-reference-and-status\",\"content\":\"Identity, reference, and status\"}],[\"/sources/github-2\",{\"id\":\"/sources/github-2\",\"page_id\":\"/sources/github\",\"type\":\"heading\",\"tags\":[],\"url\":\"/sources/github#credentials\",\"content\":\"Credentials\"}],[\"/sources/github-3\",{\"id\":\"/sources/github-3\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#github-source\",\"content\":\"Use `kind = \\\"github\\\"` with `mode = \\\"issue\\\"` to collect GitHub issues through GitHub issue search.\"}],[\"/sources/github-4\",{\"id\":\"/sources/github-4\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#github-source\",\"content\":\"Issue mode injects `is:issue` when it is missing so GitHub pull requests do not become AgentBoard Items.\"}],[\"/sources/github-5\",{\"id\":\"/sources/github-5\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#identity-reference-and-status\",\"content\":\"Issue mode uses `owner/repo#number` as `item.id` and the issue number as\\n`item.reference_id`. This keeps equal issue numbers from different repositories\\ndistinct while templates can use the normal GitHub issue number.\"}],[\"/sources/github-6\",{\"id\":\"/sources/github-6\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#identity-reference-and-status\",\"content\":\"Status comes from the first matching `status_map` entry on the issue labels. If no label matches, status falls back to the GitHub issue state.\"}],[\"/sources/github-7\",{\"id\":\"/sources/github-7\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#identity-reference-and-status\",\"content\":\"Use `field_map` only when the default normalized fields are wrong for a workspace.\"}],[\"/sources/github-8\",{\"id\":\"/sources/github-8\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#identity-reference-and-status\",\"content\":\"`field_map.id` changes `item.reference_id`; it does not change `item.id`.\"}],[\"/sources/github-9\",{\"id\":\"/sources/github-9\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#identity-reference-and-status\",\"content\":\"Use `status_map` to normalize GitHub issue labels to workspace status values.\"}],[\"/sources/github-10\",{\"id\":\"/sources/github-10\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#credentials\",\"content\":\"The credential helper is any command that writes a token to stdout. `gh auth token` is the common human-friendly helper, but any secret manager command can be used.\"}],[\"/sources/jira\",{\"id\":\"/sources/jira\",\"page_id\":\"/sources/jira\",\"type\":\"page\",\"content\":\"Jira source\",\"breadcrumbs\":[\"AgentBoard\",\"Sources\"],\"tags\":[],\"url\":\"/sources/jira\"}],[\"/sources/jira-0\",{\"id\":\"/sources/jira-0\",\"page_id\":\"/sources/jira\",\"type\":\"heading\",\"tags\":[],\"url\":\"/sources/jira#jira-source\",\"content\":\"Jira source\"}],[\"/sources/jira-1\",{\"id\":\"/sources/jira-1\",\"page_id\":\"/sources/jira\",\"type\":\"heading\",\"tags\":[],\"url\":\"/sources/jira#field-mapping\",\"content\":\"Field mapping\"}],[\"/sources/jira-2\",{\"id\":\"/sources/jira-2\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#jira-source\",\"content\":\"Use `kind = \\\"jira\\\"` to collect Jira issues with JQL.\"}],[\"/sources/jira-3\",{\"id\":\"/sources/jira-3\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#jira-source\",\"content\":\"Credentials come from environment variables by default. Defaults are `JIRA_EMAIL`\\nand `JIRA_API_TOKEN`.\"}],[\"/sources/jira-4\",{\"id\":\"/sources/jira-4\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#jira-source\",\"content\":\"Or configure a credential helper. AgentBoard writes Git-style request lines to\\nstdin (`protocol`, `host`) and reads either `username`/`password` or\\n`email`/`token` lines from stdout.\"}],[\"/sources/jira-5\",{\"id\":\"/sources/jira-5\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#field-mapping\",\"content\":\"AgentBoard uses Jira's internal issue `id` as stable `item.id` inside the Jira\\nsite's Item Store. The Jira issue key is the default `item.reference_id`.\"}],[\"/sources/jira-6\",{\"id\":\"/sources/jira-6\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#field-mapping\",\"content\":\"Defaults map `reference_id` from `key`, `title` from `fields.summary`, `status`\\nfrom `fields.status.name`, and `url` to `{site}/browse/{key}`. Override mappings\\nwhen you need custom Jira fields. Use `status_map` to normalize Jira status names.\"}],[\"/sources/jira-7\",{\"id\":\"/sources/jira-7\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#field-mapping\",\"content\":\"AgentBoard automatically requests Jira fields referenced by mapping paths that\\nstart with `fields.`. For example, `fields.customfield_10010.value` requests\\nthe top-level Jira field `customfield_10010`.\"}],[\"/sources/jira-8\",{\"id\":\"/sources/jira-8\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#field-mapping\",\"content\":\"`field_map.id` changes `item.reference_id`; it does not change `item.id`.\"}],[\"/sources/jira-9\",{\"id\":\"/sources/jira-9\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#field-mapping\",\"content\":\"Use `status_map` when Jira's status names should normalize to AgentBoard statuses.\"}],[\"/sources/jira-10\",{\"id\":\"/sources/jira-10\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#field-mapping\",\"content\":\"Use `fields` only for extra Jira API fields you want preserved in the raw\\npayload but do not use in `field_map`.\"}],[\"/sources/qmd\",{\"id\":\"/sources/qmd\",\"page_id\":\"/sources/qmd\",\"type\":\"page\",\"content\":\"QMD source\",\"breadcrumbs\":[\"AgentBoard\",\"Sources\"],\"tags\":[],\"url\":\"/sources/qmd\"}],[\"/sources/qmd-0\",{\"id\":\"/sources/qmd-0\",\"page_id\":\"/sources/qmd\",\"type\":\"heading\",\"tags\":[],\"url\":\"/sources/qmd#qmd-source\",\"content\":\"QMD source\"}],[\"/sources/qmd-1\",{\"id\":\"/sources/qmd-1\",\"page_id\":\"/sources/qmd\",\"type\":\"heading\",\"tags\":[],\"url\":\"/sources/qmd#field-mapping\",\"content\":\"Field mapping\"}],[\"/sources/qmd-2\",{\"id\":\"/sources/qmd-2\",\"page_id\":\"/sources/qmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/qmd#qmd-source\",\"content\":\"Use `kind = \\\"qmd\\\"` to collect items from QMD collections.\"}],[\"/sources/qmd-3\",{\"id\":\"/sources/qmd-3\",\"page_id\":\"/sources/qmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/qmd#qmd-source\",\"content\":\"AgentBoard runs `qmd query --full --format json` and reads each result's raw\\ndocument body. Each matched note must have YAML frontmatter with string fields\\nfor `id`, `title`, and `status`. `url` is optional; when absent AgentBoard uses\\nthe QMD document reference.\"}],[\"/sources/qmd-4\",{\"id\":\"/sources/qmd-4\",\"page_id\":\"/sources/qmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/qmd#qmd-source\",\"content\":\"The QMD document reference is `item.id`. The mapped frontmatter `id` is\\n`item.reference_id`, so moving reference mapping does not change Store or Action\\nidentity.\"}],[\"/sources/qmd-5\",{\"id\":\"/sources/qmd-5\",\"page_id\":\"/sources/qmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/qmd#field-mapping\",\"content\":\"Use `map` when your frontmatter uses different names or nested fields.\"}],[\"/sources/qmd-6\",{\"id\":\"/sources/qmd-6\",\"page_id\":\"/sources/qmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/qmd#field-mapping\",\"content\":\"`map.id` changes `item.reference_id`; it does not change `item.id`.\"}],[\"/actions/run-cmd\",{\"id\":\"/actions/run-cmd\",\"page_id\":\"/actions/run-cmd\",\"type\":\"page\",\"content\":\"Run command action\",\"breadcrumbs\":[\"AgentBoard\",\"Actions\"],\"tags\":[],\"url\":\"/actions/run-cmd\"}],[\"/actions/run-cmd-0\",{\"id\":\"/actions/run-cmd-0\",\"page_id\":\"/actions/run-cmd\",\"type\":\"heading\",\"tags\":[],\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"Run Command Action\"}],[\"/actions/run-cmd-1\",{\"id\":\"/actions/run-cmd-1\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"Use `agentboard/run-cmd` to run a shell command for each collected item.\"}],[\"/actions/run-cmd-2\",{\"id\":\"/actions/run-cmd-2\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"AgentBoard runs the command through `sh -c`. Templates can use the collected\\nitem and source fields.\"}],[\"/actions/run-cmd-3\",{\"id\":\"/actions/run-cmd-3\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"The command receives these environment variables:\"}],[\"/actions/run-cmd-4\",{\"id\":\"/actions/run-cmd-4\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"`AGENTBOARD_WORKSPACE_ID`\"}],[\"/actions/run-cmd-5\",{\"id\":\"/actions/run-cmd-5\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"`AGENTBOARD_SOURCE_ID`\"}],[\"/actions/run-cmd-6\",{\"id\":\"/actions/run-cmd-6\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"`AGENTBOARD_ITEM_ID`\"}],[\"/actions/run-cmd-7\",{\"id\":\"/actions/run-cmd-7\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"Set `cwd` when the command should run from a specific directory.\"}],[\"/actions/run-cmd-8\",{\"id\":\"/actions/run-cmd-8\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"For asynchronous launch commands, set `healthcheck` to a shell probe that\\nreports readiness with exit status `0`. AgentBoard runs the probe immediately\\nafter a successful launch, then polls until it passes or times out.\"}],[\"/actions/run-cmd-9\",{\"id\":\"/actions/run-cmd-9\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"The interval defaults to `1s`; the timeout defaults to `30s`. Both accept\\nhuman-readable durations such as `250ms`, `5s`, or `2m`. The healthcheck uses\\nthe same `cwd` and AgentBoard environment variables as `cmd`. A launch failure\\nskips the healthcheck. A timeout fails the action, so a later run retries it.\"}],[\"/actions/worktree\",{\"id\":\"/actions/worktree\",\"page_id\":\"/actions/worktree\",\"type\":\"page\",\"content\":\"Worktree action\",\"breadcrumbs\":[\"AgentBoard\",\"Actions\"],\"tags\":[],\"url\":\"/actions/worktree\"}],[\"/actions/worktree-0\",{\"id\":\"/actions/worktree-0\",\"page_id\":\"/actions/worktree\",\"type\":\"heading\",\"tags\":[],\"url\":\"/actions/worktree#worktree-action\",\"content\":\"Worktree action\"}],[\"/actions/worktree-1\",{\"id\":\"/actions/worktree-1\",\"page_id\":\"/actions/worktree\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/worktree#worktree-action\",\"content\":\"Use `agentboard/worktree` to ensure each item has a Git worktree on its\\nrequested branch. The Action creates an absent worktree, reuses a matching\\nworktree, or safely switches a clean managed worktree.\"}],[\"/actions/worktree-2\",{\"id\":\"/actions/worktree-2\",\"page_id\":\"/actions/worktree\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/worktree#worktree-action\",\"content\":\"`repo` is the source repository. `root` is a separate worktree path. `branch`\\nis a local branch name to create or switch to for the item. Existing roots must\\nbe exact worktree roots from `repo`; switching refuses tracked or untracked\\nchanges and branches already checked out elsewhere.\"}],[\"/actions/worktree-3\",{\"id\":\"/actions/worktree-3\",\"page_id\":\"/actions/worktree\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/worktree#worktree-action\",\"content\":\"Pair it with `agentboard/run-cmd` when you want to open the new worktree in a\\nterminal or agent session.\"}]]"}}