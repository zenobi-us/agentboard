iginal Source payload:\"}],[\"/cli/templates-19\",{\"id\":\"/cli/templates-19\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#filters\",\"content\":\"AgentBoard registers `slugify` for conservative path and branch names:\"}],[\"/cli/templates-20\",{\"id\":\"/cli/templates-20\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#filters\",\"content\":\"Example:\"}],[\"/cli/templates-21\",{\"id\":\"/cli/templates-21\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#rendering-and-expansion-order\",\"content\":\"AgentBoard processes Action inputs in three stages:\"}],[\"/cli/templates-22\",{\"id\":\"/cli/templates-22\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#rendering-and-expansion-order\",\"content\":\"MiniJinja renders every input.\"}],[\"/cli/templates-23\",{\"id\":\"/cli/templates-23\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#rendering-and-expansion-order\",\"content\":\"AgentBoard expands leading `~/`, `$VAR`, and `${VAR}` only in path inputs:\"}],[\"/cli/templates-24\",{\"id\":\"/cli/templates-24\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#rendering-and-expansion-order\",\"content\":\"`agentboard/run-cmd`: `cwd`\"}],[\"/cli/templates-25\",{\"id\":\"/cli/templates-25\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#rendering-and-expansion-order\",\"content\":\"`agentboard/worktree`: `repo`, `root`\"}],[\"/cli/templates-26\",{\"id\":\"/cli/templates-26\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#rendering-and-expansion-order\",\"content\":\"`agentboard/run-cmd` passes `cmd` and `healthcheck` to `sh -c`. The shell expands command variables after changing to `cwd`.\"}],[\"/cli/templates-27\",{\"id\":\"/cli/templates-27\",\"page_id\":\"/cli/temp