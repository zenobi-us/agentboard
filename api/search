\"content\":\"Templates\"}],[\"/cli/templates-1\",{\"id\":\"/cli/templates-1\",\"page_id\":\"/cli/templates\",\"type\":\"heading\",\"tags\":[],\"url\":\"/cli/templates#context\",\"content\":\"Context\"}],[\"/cli/templates-2\",{\"id\":\"/cli/templates-2\",\"page_id\":\"/cli/templates\",\"type\":\"heading\",\"tags\":[],\"url\":\"/cli/templates#filters\",\"content\":\"Filters\"}],[\"/cli/templates-3\",{\"id\":\"/cli/templates-3\",\"page_id\":\"/cli/templates\",\"type\":\"heading\",\"tags\":[],\"url\":\"/cli/templates#rendering-and-expansion-order\",\"content\":\"Rendering and expansion order\"}],[\"/cli/templates-4\",{\"id\":\"/cli/templates-4\",\"page_id\":\"/cli/templates\",\"type\":\"heading\",\"tags\":[],\"url\":\"/cli/templates#action-hash\",\"content\":\"Action hash\"}],[\"/cli/templates-5\",{\"id\":\"/cli/templates-5\",\"page_id\":\"/cli/templates\",\"type\":\"heading\",\"tags\":[],\"url\":\"/cli/templates#examples\",\"content\":\"Examples\"}],[\"/cli/templates-6\",{\"id\":\"/cli/templates-6\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#templates\",\"content\":\"Action inputs are MiniJinja templates.\"}],[\"/cli/templates-7\",{\"id\":\"/cli/templates-7\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#context\",\"content\":\"Templates can read:\"}],[\"/cli/templates-8\",{\"id\":\"/cli/templates-8\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#context\",\"content\":\"`workspace`\"}],[\"/cli/templates-9\",{\"id\":\"/cli/templates-9\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#context\",\"content\":\"`source`\"}],[\"/cli/templates-10\",{\"id\":\"/cli/templates-10\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":\"/cli/templates#context\",\"content\":\"`item`\"}],[\"/cli/templates-11\",{\"id\":\"/cli/templates-11\",\"page_id\":\"/cli/templates\",\"tags\":[],\"type\":\"text\",\"url\":