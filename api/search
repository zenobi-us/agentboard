sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#github-source\",\"content\":\"Issue mode injects `is:issue` when it is missing so GitHub pull requests do not become AgentBoard Items.\"}],[\"/sources/github-5\",{\"id\":\"/sources/github-5\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#identity-and-status\",\"content\":\"Issue mode item ids default to `owner/repo#number`. Status comes from the first matching `status_map` entry on the issue labels. If no label matches, status falls back to the GitHub issue state.\"}],[\"/sources/github-6\",{\"id\":\"/sources/github-6\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#identity-and-status\",\"content\":\"Use `field_map` only when the default normalized fields are wrong for a workspace.\"}],[\"/sources/github-7\",{\"id\":\"/sources/github-7\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#identity-and-status\",\"content\":\"Use `status_map` to normalize GitHub issue labels to workspace status values.\"}],[\"/sources/github-8\",{\"id\":\"/sources/github-8\",\"page_id\":\"/sources/github\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/github#credentials\",\"content\":\"The credential helper is any command that writes a token to stdout. `gh auth token` is the common human-friendly helper, but any secret manager command can be used.\"}],[\"/sources/jira\",{\"id\":\"/sources/jira\",\"page_id\":\"/sources/jira\",\"type\":\"page\",\"content\":\"Jira source\",\"breadcrumbs\":[\"AgentBoard\",\"Sources\"],\"tags\":[],\"url\":\"/sources/jira\"}],[\"/sources/jira-0\",{\"id\":\"/sources/jira-0\",\"page_id\":\"/sources/jira\",\"type\":\"heading\",\"tags\":[],\"url\":\"/sources/jira#jira-source\",\"content\":\"Jira source\"}],[\"/sources/jira-1\",{\"id\":\"/sources/jira-1\",\"page_id\":\"/sources/jira\",\"type\":\"heading\",\"tags\":[],\"url\":\"/sources/jira#field-mapping\",\"content\":\"Field mapping\"}],[\"/sources/jira-2\",{\"id\":\"/sources/jira-2\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#jira-source\",\"content\":\"Use `kind = \\\"jira\\\"` to collect Jira issues with JQL.\"}],[\"/sources/jira-3\",{\"id\":\"/sources/jira-3\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#jira-source\",\"content\":\"Credentials come from environment variables by default. Defaults are `JIRA_EMAIL`\\nand `JIRA_API_TOKEN`.\"}],[\"/sources/jira-4\",{\"id\":\"/sources/jira-4\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#jira-source\",\"content\":\"Or configure a credential helper. AgentBoard writes Git-style request lines to\\nstdin (`protocol`, `host`) and reads either `username`/`password` or\\n`email`/`token` lines from stdout.\"}],[\"/sources/jira-5\",{\"id\":\"/sources/jira-5\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#field-mapping\",\"content\":\"Defaults map `id` from `key`, `title` from `fields.summary`, `status` from\\n`fields.status.name`, and `url` to `{site}/browse/{key}`. Override mappings\\nwhen you need custom Jira fields. Use `status_map` to normalize Jira status names.\"}],[\"/sources/jira-6\",{\"id\":\"/sources/jira-6\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#field-mapping\",\"content\":\"AgentBoard automatically requests Jira fields referenced by mapping paths that\\nstart with `fields.`. For example, `fields.customfield_10010.value` requests\\nthe top-level Jira field `customfield_10010`.\"}],[\"/sources/jira-7\",{\"id\":\"/sources/jira-7\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#field-mapping\",\"content\":\"Use `status_map` when Jira's status names should normalize to AgentBoard statuses.\"}],[\"/sources/jira-8\",{\"id\":\"/sources/jira-8\",\"page_id\":\"/sources/jira\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/jira#field-mapping\",\"content\":\"Use `fields` only for extra Jira API fields you want preserved in the raw\\npayload but do not use in `field_map`.\"}],[\"/sources/qmd\",{\"id\":\"/sources/qmd\",\"page_id\":\"/sources/qmd\",\"type\":\"page\",\"content\":\"QMD source\",\"breadcrumbs\":[\"AgentBoard\",\"Sources\"],\"tags\":[],\"url\":\"/sources/qmd\"}],[\"/sources/qmd-0\",{\"id\":\"/sources/qmd-0\",\"page_id\":\"/sources/qmd\",\"type\":\"heading\",\"tags\":[],\"url\":\"/sources/qmd#qmd-source\",\"content\":\"QMD source\"}],[\"/sources/qmd-1\",{\"id\":\"/sources/qmd-1\",\"page_id\":\"/sources/qmd\",\"type\":\"heading\",\"tags\":[],\"url\":\"/sources/qmd#field-mapping\",\"content\":\"Field mapping\"}],[\"/sources/qmd-2\",{\"id\":\"/sources/qmd-2\",\"page_id\":\"/sources/qmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/qmd#qmd-source\",\"content\":\"Use `kind = \\\"qmd\\\"` to collect items from QMD collections.\"}],[\"/sources/qmd-3\",{\"id\":\"/sources/qmd-3\",\"page_id\":\"/sources/qmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/qmd#qmd-source\",\"content\":\"AgentBoard runs `qmd query`, then `qmd get --full` for each result. Each\\nmatched note must have YAML frontmatter with string fields for `id`, `title`,\\nand `status`. `url` is optional; when absent AgentBoard uses the QMD document\\nreference.\"}],[\"/sources/qmd-4\",{\"id\":\"/sources/qmd-4\",\"page_id\":\"/sources/qmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/sources/qmd#field-mapping\",\"content\":\"Use `map` when your frontmatter uses different names or nested fields.\"}],[\"/actions/run-cmd\",{\"id\":\"/actions/run-cmd\",\"page_id\":\"/actions/run-cmd\",\"type\":\"page\",\"content\":\"Run command action\",\"breadcrumbs\":[\"AgentBoard\",\"Actions\"],\"tags\":[],\"url\":\"/actions/run-cmd\"}],[\"/actions/run-cmd-0\",{\"id\":\"/actions/run-cmd-0\",\"page_id\":\"/actions/run-cmd\",\"type\":\"heading\",\"tags\":[],\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"Run command action\"}],[\"/actions/run-cmd-1\",{\"id\":\"/actions/run-cmd-1\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"Use `agentboard/run-cmd` to run a shell command for each collected item.\"}],[\"/actions/run-cmd-2\",{\"id\":\"/actions/run-cmd-2\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"AgentBoard runs the command through `sh -c`. Templates can use the collected\\nitem and source fields.\"}],[\"/actions/run-cmd-3\",{\"id\":\"/actions/run-cmd-3\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"The command receives these environment variables:\"}],[\"/actions/run-cmd-4\",{\"id\":\"/actions/run-cmd-4\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"`AGENTBOARD_WORKSPACE_ID`\"}],[\"/actions/run-cmd-5\",{\"id\":\"/actions/run-cmd-5\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"`AGENTBOARD_SOURCE_ID`\"}],[\"/actions/run-cmd-6\",{\"id\":\"/actions/run-cmd-6\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"`AGENTBOARD_ITEM_ID`\"}],[\"/actions/run-cmd-7\",{\"id\":\"/actions/run-cmd-7\",\"page_id\":\"/actions/run-cmd\",\"tags\":[],\"type\":\"text\",\"url\":\"/actions/run-cmd#run-command-action\",\"content\":\"Set `cwd` when the command should run from a specific directory.\"}],[\"/actions/worktree\",{\"id\":\"/actions/worktree\",\"page_id\":\"/actions/worktree\",\"type\":\"page\",\"content\":\"Create worktree action\",\"breadcrumbs\":[\"AgentBoard\",\"Actions\"],\"tags\":[],\"url\":\"/actions/worktree\"}],[\"/actions/worktree-0\",{\"id\":\"/actions/worktree-0\",\"page_id\":\"/actions/worktree\",\