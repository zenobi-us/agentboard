#!/usr/bin/env bash
set -euo pipefail

base="${1:-}"
head="${2:-}"

[[ -n "${base}" ]] || { echo "Missing base argument" >&2; exit 1; }
[[ -n "${head}" ]] || { echo "Missing head argument" >&2; exit 1; }

MOON_BASE="${base}" MOON_HEAD="${head}" moon query projects --affected \
  | jq -ce '[
      .projects[]?
      | select((.tasks // {}) | has("publish"))
      | {target: .id}
    ]
    | unique_by(.target)
    | sort_by(.target)'
