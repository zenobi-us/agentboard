layout {
    // For the initial tab creation.
    // The default tab template is used for the first tab, and the new tab template is used for any subsequent tabs.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zellij-tabbar.wasm"
        }
        pane split_direction="vertical" {
            pane size=32 borderless=true {
                plugin location="file:~/.config/zellij/plugins/zellij-agent-threads.wasm"
            }
            pane focus=true {
                children
            }
        }
    }

    // For any subsequent tab creation.
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zellij-tabbar.wasm"
        }
        pane split_direction="vertical" {
            pane size=32 borderless=true {
                plugin location="file:~/.config/zellij/plugins/zellij-agent-threads.wasm"
            }
            pane focus=true {
                children
            }
        }
    }

    tab name="queue" focus=true {
        pane command="agentboard" {
            args "watch" ".agentboard.toml" "--interval" "30s"
        }
    }
}

session_serialization false
