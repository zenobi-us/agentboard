{
  "name": "@agentboard/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "agentboard": "dist/cli"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build src/cli/index.ts --target bun --format esm --external minijinja-js --outfile dist/cli",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "start": "./dist/cli"
  },
  "dependencies": {
    "@agentboard/action-run-cmd": "workspace:*",
    "@agentboard/action-worktree": "workspace:*",
    "@agentboard/core": "workspace:*",
    "@agentboard/source-github": "workspace:*",
    "@agentboard/source-jira": "workspace:*",
    "@agentboard/source-qmd": "workspace:*",
    "minijinja-js": "^2.24.0"
  },
  "devDependencies": {
    "@crustjs/core": "^0.0.19",
    "@crustjs/crust": "^0.0.24",
    "@crustjs/plugins": "^0.1.2",
    "@types/bun": "^1.3.14",
    "typebox": "^1.3.4",
    "typescript": "^6.0.3"
  }
}
